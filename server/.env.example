# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env to version control.

# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supported fast model with structured JSON output
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: fallback model used if primary fails with a transient 503/429.
# Leave empty to disable.
GEMINI_FALLBACK_MODEL=

# Local Express server port
PORT=5000
